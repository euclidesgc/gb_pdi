# Padrões para rodar a API localmente (npm run dev:api / launch do VS Code).
# Sem segredos: o banco é o Postgres local de scripts/dev-db.sh. Para sobrescrever
# algo na sua máquina, use .env.local (não versionado).
DATABASE_URL=postgres://gbpdi@127.0.0.1:54329/gbpdi
PORT=3000
APP_URL=http://localhost:5173
